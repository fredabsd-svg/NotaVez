{
  "name": "nota-sem-stress-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor do Nota Sem Stress: contas, clientes, rascunhos, histórico e integração com a API oficial da NFS-e Nacional",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "NOTAVEZ_DEV=1 node --disable-warning=ExperimentalWarning --watch src/index.js",
    "test": "node scripts/testar.mjs",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.js",
    "homologacao": "node --disable-warning=ExperimentalWarning scripts/homologacao.js",
    "gerar-chave": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "backup": "node scripts/backup.mjs",
    "migrar": "node scripts/migrar.mjs",
    "test:web": "node scripts/smoke-web.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "unpdf": "^2.2.0",
    "xml-crypto": "^6.3.2",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "playwright": "1.63.0"
  }
}
