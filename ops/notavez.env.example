PORT=8080
HOST=127.0.0.1
NOTAVEZ_DB=/var/lib/notavez/notavez.db
NOTAVEZ_MASTER_KEY=
NOTAVEZ_PROXIES_CONFIAVEIS=127.0.0.1,::1
# Liberar somente após homologação oficial revisada:
NOTAVEZ_PRODUCAO_LIBERADA=0
# De quantas em quantas horas o servidor busca na Receita (ADN) as notas tomadas e as emitidas fora do app
# de todas as empresas com certificado válido. Padrão 6; 0 desliga (a busca fica só pelos botões do app).
NOTAVEZ_SINCRONIZACAO_HORAS=6
NOTAVEZ_RESPONSAVEL=
NOTAVEZ_CONTATO_PRIVACIDADE=
NOTAVEZ_RETENCAO=
# Recuperação de senha. Sem nada configurado, vale só o código de recuperação (dado no primeiro acesso).
# Opção A — e-mail direto por SMTP (TLS obrigatório):
#   NOTAVEZ_SMTP_URL=smtps://usuario%40dominio:senha@smtp.seuprovedor.com:465   (ou smtp://...:587 com STARTTLS)
#   NOTAVEZ_SMTP_DE=nao-responda@seudominio.com.br
#   NOTAVEZ_URL_PUBLICA=https://app.seudominio.com.br
NOTAVEZ_SMTP_URL=
NOTAVEZ_SMTP_DE=
NOTAVEZ_URL_PUBLICA=
# Opção B — webhook HTTPS de um serviço seu de e-mail/SMS:
NOTAVEZ_RECUPERACAO_WEBHOOK=
NOTAVEZ_RECUPERACAO_WEBHOOK_TOKEN=
NOTAVEZ_ASSETLINKS_FILE=
# Entrar com gov.br (Login Único). Credenciais concedidas pelo governo para a URL de
# retorno abaixo; vazio = botão gov.br escondido. AMBIENTE: producao | staging.
NOTAVEZ_GOVBR_CLIENT_ID=
NOTAVEZ_GOVBR_CLIENT_SECRET=
NOTAVEZ_GOVBR_REDIRECT_URI=https://seu-dominio/api/conta/govbr/retorno
NOTAVEZ_GOVBR_AMBIENTE=producao
