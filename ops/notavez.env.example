PORT=8080
HOST=127.0.0.1
NOTAVEZ_DB=/var/lib/notavez/notavez.db
NOTAVEZ_MASTER_KEY=
NOTAVEZ_PROXIES_CONFIAVEIS=127.0.0.1,::1
# Liberar somente após homologação oficial revisada:
NOTAVEZ_PRODUCAO_LIBERADA=0
NOTAVEZ_RESPONSAVEL=
NOTAVEZ_CONTATO_PRIVACIDADE=
NOTAVEZ_RETENCAO=
NOTAVEZ_RECUPERACAO_WEBHOOK=
NOTAVEZ_RECUPERACAO_WEBHOOK_TOKEN=
NOTAVEZ_ASSETLINKS_FILE=
# Endereço público do app (https://...), usado nos retornos de gov.br e certificado.
NOTAVEZ_APP_ORIGEM=
# Bancos das contas (um arquivo por conta). Padrão: pasta "contas" ao lado de NOTAVEZ_DB.
NOTAVEZ_CONTAS_DIR=
# Entrar com gov.br: credenciais do Login Único concedidas a ESTE serviço.
# NOTAVEZ_GOVBR_AMBIENTE: staging (homologação do gov.br) ou producao.
NOTAVEZ_GOVBR_CLIENT_ID=
NOTAVEZ_GOVBR_CLIENT_SECRET=
NOTAVEZ_GOVBR_AMBIENTE=staging
# Opcional (padrão: $NOTAVEZ_APP_ORIGEM/api/conta/govbr/retorno):
NOTAVEZ_GOVBR_REDIRECT_URI=
# Entrar com certificado digital: host do Caddy que pede o certificado,
# segredo compartilhado com o Caddy e cadeias oficiais da ICP-Brasil (PEM).
NOTAVEZ_CERT_LOGIN_ORIGEM=
NOTAVEZ_CERT_PROXY_SEGREDO=
NOTAVEZ_ICP_CADEIAS=/etc/notavez/icp-brasil.pem
